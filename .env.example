# Copy this file to ".env" and fill in your real values. Never commit ".env" to GitHub.

# Pick ONE of these depending on which LLM you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: only needed once you build the WhatsApp alert feature (Phase 8)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Default location for weather data (example: Guntur, Andhra Pradesh) — change to your target district
DEFAULT_LATITUDE=16.3067
DEFAULT_LONGITUDE=80.4365
